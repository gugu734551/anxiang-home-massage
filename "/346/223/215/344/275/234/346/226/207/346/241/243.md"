/* 按摩师页：固定卡片内部比例，避免浏览器缩放时两列互相挤压 */
.therapists-page .therapist-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:1fr;align-items:stretch}
.therapists-page .therapist-grid .therapist-card{width:100%;min-width:0;min-height:154px;height:100%;grid-template-columns:minmax(76px,43%) minmax(0,57%);grid-template-rows:1fr 31px;gap:8px;padding:8px}
.therapists-page .therapist-grid .therapist-card>.photo{width:100%;height:100%;min-height:112px;grid-row:1/3;background-position:center top!important}
.therapists-page .therapist-grid .therapist-copy{min-width:0;overflow:hidden;gap:2px}
.therapists-page .therapist-grid .therapist-copy>b,.therapists-page .therapist-grid .therapist-copy>small{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.therapists-page .therapist-grid .tags{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px}
.therapists-page .therapist-grid .tags span{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;text-align:center;padding:3px 4px}
.therapists-page .therapist-grid .available{position:static;grid-column:2;width:100%;min-width:0;height:31px;padding:0 8px;align-self:end;justify-content:center}
@media(max-width:365px){.therapists-page .therapist-grid{grid-template-columns:1fr}.therapists-page .therapist-grid .therapist-card{min-height:148px;grid-template-columns:38% minmax(0,62%)}}

